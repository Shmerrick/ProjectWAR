<?xml version="1.0" encoding="utf-8" ?>
<!--
  Logging is on the combat and region-tick paths, so this file is tuned for a live server rather
  than for a debugging session. Three settings matter and are easy to get wrong:

    * The catch-all file/console rules run at Info. At Trace the world log reached 34 MB and 275,000
      lines in a single day with one player online, most of it per-swing stat maths. autoReload is on,
      so to debug something you can change minlevel below to Debug or Trace and save this file - the
      running server picks it up within a couple of seconds, no restart needed. Put it back afterwards.
    * overflowAction is Discard. With Block, a full async queue stalls whatever thread produced the
      message, and that thread is usually the 50 ms region tick - the simulation would wait on disk.
      Dropping log lines under load is the correct trade for a game server.
    * NLog's own internal log is off. It was writing Trace-level diagnostics to a hardcoded
      c:\temp\nlog-internal.log, two to four lines per log event, and had reached 656 MB with no
      rotation. Set internalLogLevel to Warn and add an internalLogFile only while debugging NLog itself.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <targets>
    <!-- Discard rather than Block: see the header note about stalling the region tick. -->
    <default-wrapper xsi:type="AsyncWrapper" timeToSleepBetweenBatches="0" queueLimit="20000" overflowAction="Discard" />

    <!-- The file name already carries ${shortdate}, so rollover is daily. These cap a single day at
         64 MB and expire archives after 14 days, so no log grows unbounded the way the internal one did. -->
    <default-target-parameters xsi:type="File"
                               layout="${longdate} ${uppercase:${level}} ${callsite:includeNamespace=false} :: ${message}"
                               archiveNumbering="Sequence"
                               archiveAboveSize="67108864"
                               maxArchiveFiles="14"
                               maxArchiveDays="14" />

    <target name="logfile" xsi:type="File" fileName="${basedir}/logs/${processname}_${shortdate}.log" />
    <target name="rewardLogToFile" xsi:type="File" fileName="${basedir}/logs/REWARD_${shortdate}.log" />
    <target name="deathLogToFile" xsi:type="File" fileName="${basedir}/logs/DEATH_${shortdate}.log" />
    <target name="rvrLogToFile" xsi:type="File" fileName="${basedir}/logs/RVR_${shortdate}.log" />
    <target name="battlefrontLogToFile" xsi:type="File" fileName="${basedir}/logs/Campaign_${shortdate}.log" />
    <target name="guildLogToFile" xsi:type="File" fileName="${basedir}/logs/Guild_${shortdate}.log" />
    <target name="bountyLogToFile" xsi:type="File" fileName="${basedir}/logs/BOUNTY_${shortdate}.log" />
    <target name="mailLogToFile" xsi:type="File" fileName="${basedir}/logs/MAIL_${shortdate}.log" />

    <target name="logconsole" xsi:type="ColoredConsole" layout="${shortdate} ${uppercase:${level}} ${message}" useDefaultRowHighlightingRules="false">
      <highlight-row condition="starts-with('${message}', 'S ')" foregroundColor="Green" />
      <highlight-row condition="starts-with('${message}', 'E ')" foregroundColor="Red" />
      <highlight-row condition="starts-with('${message}', 'I ')" foregroundColor="White" />
      <highlight-row condition="starts-with('${message}', 'N ')" foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Debug" foregroundColor="DarkGray" />
      <highlight-row condition="level == LogLevel.Trace" foregroundColor="DarkGray" />
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" />
    </target>
  </targets>

  <rules>
    <!-- The dedicated audit logs stay at Trace: they are deliberately narrow and low volume, and they
         are the record you actually want when investigating a death, a reward or a campaign flip. -->
    <logger name="MailLogger" minlevel="Trace" writeTo="mailLogToFile" />
    <logger name="DeathLogger" minlevel="Trace" writeTo="deathLogToFile" />
    <logger name="RewardLogger" minlevel="Trace" writeTo="rewardLogToFile" />
    <logger name="BountyLogger" minlevel="Trace" writeTo="bountyLogToFile" />
    <logger name="RVRProgressionLogger" minlevel="Trace" writeTo="battlefrontLogToFile" />

    <!-- Raise to Debug or Trace here to diagnose; autoReload applies it to the running server. -->
    <logger name="*" minlevel="Info" writeTo="logfile" />
    <logger name="*" minlevel="Info" writeTo="logconsole" />
  </rules>
</nlog>
