<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>LauncherServer</RootNamespace>
        <AssemblyName>LauncherServer</AssemblyName>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationIcon>launcher.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\test\Core.Infrastructure.Network.Tests\Core.Infrastructure.Network.Tests.csproj" />
        <ProjectReference Include="..\Common\Common.csproj"/>
        <ProjectReference Include="..\LauncherServer.Dtos\LauncherServer.Dtos.csproj" />
        <ProjectReference Include="..\Core.Infrastructure.Network.RpcSourceGenerators\Core.Infrastructure.Network.RpcSourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="launcher.ico"/>
    </ItemGroup>
    <ItemGroup>
        <Protobuf Include="..\..\protos\common\**\*.proto" ProtoRoot="..\..\protos" />
        <Protobuf Include="..\..\protos\AccountMgr.proto" GrpcServices="Client" ProtoRoot="..\..\protos" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
      <PackageReference Include="Grpc.Tools" Version="2.72.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    </ItemGroup>
</Project>