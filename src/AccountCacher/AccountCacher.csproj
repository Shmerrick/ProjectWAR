<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>AccountCacher</RootNamespace>
        <AssemblyName>AccountCacher</AssemblyName>
        <ApplicationIcon>account.ico</ApplicationIcon>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\..\AccountMgr.proto" GrpcServices="Server" />
    </ItemGroup>

    <ItemGroup>
        <None Include="app.config"/>
        <None Include="packages.config"/>
        <Content Include="account.ico"/>
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\Common\Common.csproj"/>
        <ProjectReference Include="..\FrameWork\FrameWork.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Google.ProtocolBuffers" Version="2.4.1.555" />
      <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    </ItemGroup>

</Project>