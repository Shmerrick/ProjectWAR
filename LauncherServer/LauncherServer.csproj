<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>LauncherServer</RootNamespace>
        <AssemblyName>LauncherServer</AssemblyName>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationIcon>launcher.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Include="app.config"/>
        <None Include="packages.config"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Common\Common.csproj"/>
        <ProjectReference Include="..\FrameWork\FrameWork.csproj"/>
        <ProjectReference Include="..\LauncherServer.Dtos\LauncherServer.Dtos.csproj" />
        <ProjectReference Include="..\RpcSourceGenerator\RpcSourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="launcher.ico"/>
    </ItemGroup>
    <ItemGroup>
        <Protobuf Include="..\AccountMgr.proto" GrpcServices="Client"/>
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
      <PackageReference Include="Grpc.Tools" Version="2.72.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>
</Project>