<Project>
  <Target Name="MoveLibrariesToLibs" AfterTargets="Build" Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe'">
    <ItemGroup>
      <!-- Read resolved inputs, not the shared output folder which other projects are still writing. -->
      <RuntimeLibraries Include="@(ReferenceCopyLocalPaths)"
                        Condition="('%(Extension)' == '.dll' Or '%(Extension)' == '.config') And '%(Filename)' != 'Common' And '%(Filename)' != 'FrameWork' And '%(Filename)' != 'Common.dll' And '%(Filename)' != 'FrameWork.dll'" />
      <RuntimeContentLibraries Include="@(ContentWithTargetPath)"
                               Condition="'%(ContentWithTargetPath.CopyToOutputDirectory)' != '' And '%(ContentWithTargetPath.CopyToOutputDirectory)' != 'Never' And '%(ContentWithTargetPath.Extension)' == '.dll'" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)libs" Condition="'@(RuntimeLibraries)' != '' Or '@(RuntimeContentLibraries)' != ''" />
    <Copy SourceFiles="@(RuntimeLibraries)"
          DestinationFiles="@(RuntimeLibraries->'$(OutDir)libs\%(DestinationSubDirectory)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(RuntimeLibraries)' != ''"
          Retries="3"
          RetryDelayMilliseconds="100" />
    <Copy SourceFiles="@(RuntimeContentLibraries)"
          DestinationFiles="@(RuntimeContentLibraries->'$(OutDir)libs\%(TargetPath)')"
          SkipUnchangedFiles="true"
          Condition="'@(RuntimeContentLibraries)' != ''"
          Retries="3"
          RetryDelayMilliseconds="100" />
  </Target>
</Project>
